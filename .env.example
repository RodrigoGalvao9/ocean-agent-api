API_HOST=0.0.0.0
API_PORT=8000

# Integracoes obrigatorias
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_AUTH_TOKEN=
ALLOWED_TOOLS=buscar_conhecimento,listar_topicos
REQUEST_TIMEOUT_SECONDS=30

# Aplicacao
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS
CORS_ORIGINS=http://localhost:5173

# Redis e protecao
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=8
RATE_LIMIT_CHAT_PER_DAY=100
RATE_LIMIT_GLOBAL_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=60
TRUSTED_PROXY_HOPS=1
MAX_REQUEST_BODY_BYTES=16384
MAX_HISTORY_MESSAGES=12
MAX_MESSAGES_PER_CONVERSATION=60
MAX_CONVERSATIONS=1000

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=us.cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0

# Metricas Prometheus
METRICS_TOKEN=
