API_HOST=0.0.0.0
API_PORT=8000

# Integracoes obrigatorias
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_REFINER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_VALIDATOR_MODEL=nvidia/nemotron-3-ultra:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_AUTH_TOKEN=
ALLOWED_TOOLS=search_maritime_knowledge,list_knowledge_topics,get_marine_conditions,get_tide_table,get_fishing_closures,search_vessels,find_fish_markets
REQUEST_TIMEOUT_SECONDS=30
# Partida a frio do MCP (plano free do Render): espera maior quando ele estava dormindo
MCP_COLD_START_TIMEOUT_SECONDS=60
MCP_WARM_WINDOW_SECONDS=600
MCP_TOOLS_CACHE_TTL_SECONDS=300
MAX_TOOL_OUTPUT_CHARS=12000

# Aplicacao
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS
CORS_ORIGINS=http://localhost:5173

# Redis e protecao
CONVERSATION_SESSION_SECRET=
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=8
RATE_LIMIT_CHAT_PER_DAY=100
RATE_LIMIT_GLOBAL_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=60
TRUSTED_PROXY_HOPS=1
MAX_REQUEST_BODY_BYTES=16384
MAX_HISTORY_MESSAGES=12
MAX_MESSAGES_PER_CONVERSATION=60
MAX_CONVERSATIONS=1000

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=us.cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_CONTENT=false

# Metricas Prometheus
METRICS_TOKEN=
